{
  "expo": {
    "name": "Recurrly",
    "slug": "recurrly",
    "version": "1.0.0",
    "scheme": "recurrly",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0F1A",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.recurrly.app"
    },
    "android": {
      "package": "com.recurrly.app",
      "adaptiveIcon": { "backgroundColor": "#0B0F1A" }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      ["expo-notifications", { "color": "#6C5CE7" }]
    ],
    "extra": {
      "eas": { "projectId": "REPLACE_WITH_EAS_PROJECT_ID" }
    }
  }
}
